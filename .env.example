# ==========================================================================
# Panah VPN Panel runtime configuration
# The installer writes the real file to /etc/panah/panel.env (mode 0600).
# Copy to .env only for local development.
# ==========================================================================

# panel  -> full control plane (master), node -> lightweight agent only
PANAH_MODE=panel

# Where the panel keeps its state. Created on first boot.
PANAH_DATA_DIR=/opt/panah/data
# SQLite lives inside the data dir unless overridden.
# PANAH_DB_PATH=/opt/panah/data/panah.db
PANAH_LOG_DIR=/var/log/panah

# Bind address for the web UI. Keep 127.0.0.1 when a TLS reverse proxy sits
# in front, otherwise use 0.0.0.0 to expose the panel directly.
PANAH_HOST=127.0.0.1
PANAH_PORT=8080

# Public hostname used for cookies, CORS and generated links.
PANAH_DOMAIN=panel.example.com
# Comma separated list of origins allowed to call the API.
# PANAH_ALLOWED_ORIGINS=https://panel.example.com

# Secret material. If unset the installer generates these once and stores them
# in /etc/panah/secrets/ with 0600. Never reuse between environments.
# PANAH_SECRET_KEY=<64 hex chars>
# PANAH_ENCRYPTION_KEY=<urlsafe base64 32 bytes>

# Session policy
PANAH_ACCESS_TOKEN_MINUTES=30
PANAH_REFRESH_TOKEN_DAYS=7
# Set to 1 when running behind HTTPS; required in production.
PANAH_COOKIE_SECURE=1

# Bootstrap administrator (created only when the users table is empty)
PANAH_ADMIN_USERNAME=admin
# PANAH_ADMIN_PASSWORD=          # generated & printed by the installer if unset

# Node agent
PANAH_AGENT_PORT=8787
# Shared key the master panel presents to the agent. Generated by the installer.
# PANAH_AGENT_KEY=

# Hardening
PANAH_MAX_LOGIN_ATTEMPTS=5
PANAH_LOGIN_LOCK_SECONDS=900
PANAH_RATE_LIMIT_PER_MINUTE=240
# Comma separated IPs that may always reach the panel (empty = no allowlist).
# PANAH_IP_ALLOWLIST=
PANAH_TRUSTED_PROXIES=127.0.0.1,::1
